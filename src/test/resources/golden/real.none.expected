(set-logic HORN)
(declare-fun R (Real Int) Bool)

(assert (forall ((n Int) (r Real)) (=> (and (= r 1.0) (= n 0)) (R r n))))
(assert (forall ((n Int) (r Real)) (=> (and (R r n)) (R (+ r (/ 1.0 2.0)) (+ n 1)))))
(assert (forall ((n Int) (r Real)) (=> (and (R r n) (< r (- 1.0)) (> (to_real n) 2.5)) false)))
(check-sat)
